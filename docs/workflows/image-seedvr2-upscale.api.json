{
  "_comment": "图片超分 · 单图 · SeedVR2 3B。重写版：改用 SeedVR2 官方节点链（LoadDiTModel/LoadVAEModel/VideoUpscaler），模型名与 models/SEEDVR2 磁盘实况一致。旧版 单图超分.json 走 UNETLoader/VAELoader，去 diffusion_models / vae 目录找 seedvr2_3b_nvfp4 + seedvr2_ema_vae_fp16，两个文件本机都不存在，跑不了。",
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "placeholder.png"
    },
    "_meta": { "title": "超分输入图" }
  },
  "20": {
    "class_type": "SeedVR2LoadDiTModel",
    "inputs": {
      "model": "seedvr2_ema_3b_fp8_e4m3fn.safetensors",
      "device": "cuda:0",
      "blocks_to_swap": 0,
      "swap_io_components": false,
      "offload_device": "cpu",
      "cache_model": true,
      "attention_mode": "sdpa"
    },
    "_meta": { "title": "SeedVR2 DiT" }
  },
  "21": {
    "class_type": "SeedVR2LoadVAEModel",
    "inputs": {
      "model": "ema_vae_fp16.safetensors",
      "device": "cuda:0",
      "encode_tiled": true,
      "encode_tile_size": 1024,
      "encode_tile_overlap": 128,
      "decode_tiled": true,
      "decode_tile_size": 1024,
      "decode_tile_overlap": 128,
      "tile_debug": "false",
      "offload_device": "cpu",
      "cache_model": true
    },
    "_meta": { "title": "SeedVR2 VAE" }
  },
  "30": {
    "class_type": "SeedVR2VideoUpscaler",
    "inputs": {
      "image": ["10", 0],
      "dit": ["20", 0],
      "vae": ["21", 0],
      "seed": 42,
      "resolution": 1080,
      "max_resolution": 4096,
      "batch_size": 1,
      "uniform_batch_size": false,
      "temporal_overlap": 0,
      "prepend_frames": 0,
      "color_correction": "lab",
      "input_noise_scale": 0.0,
      "latent_noise_scale": 0.0,
      "offload_device": "cpu",
      "enable_debug": false
    },
    "_meta": { "title": "SeedVR2 超分" }
  },
  "40": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["30", 0],
      "filename_prefix": "seedvr2_upscale"
    },
    "_meta": { "title": "保存超分图" }
  }
}
